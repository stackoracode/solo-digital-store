# Copy to .env for local/dev use. NEVER commit real values. Production secrets belong in the host's
# secret manager / environment, not in files.
ENV=development
APP_NAME=Solo Digital Store
PUBLIC_BASE_URL=http://localhost:8000
PRIMARY_HOSTS=localhost,127.0.0.1
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For (e.g. Cloudflare ranges / your LB).
TRUSTED_PROXY_CIDRS=
TRUST_CF_CONNECTING_IP=false

DATABASE_URL=postgresql+psycopg://store:store@db:5432/store
REDIS_URL=redis://redis:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
FINGERPRINT_KEY=dev-insecure-fingerprint-key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; the first key encrypts, all keys decrypt (rotation). Required in production.
DATA_ENCRYPTION_KEYS=
COOKIE_SECURE=false
ADMIN_REQUIRE_MFA=true

# Cloudflare Turnstile (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail (dev: Mailpit at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Solo Digital Store <no-reply@example.com>

# Login providers (enabled only when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Generic OIDC slot, e.g. a Logto tenant: OIDC_METADATA_URL=https://<tenant>.logto.app/oidc/.well-known/openid-configuration
OIDC_NAME=
OIDC_DISPLAY_NAME=SSO
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Payments ------------------------------------------------------------------------------
# Simulated provider for development/CI only. Must be false in production (enforced).
MOCK_PAYMENTS_ENABLED=true
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# Waffo Pancake: API key is bound to test or prod when created in the dashboard.
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_MERCHANT_ID=
# PEM (or base64 body). Keep in a secret manager.
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY_TEST=
WAFFO_WEBHOOK_PUBLIC_KEY_PROD=
# Hard gate for live Waffo. Products also need "approved by Waffo merchant review".
WAFFO_LIVE_ENABLED=false

# USDT: account-level xpub (m/44'/60'/0') of a self-custodial wallet. NEVER a seed phrase or xprv.
USDT_XPUB=
USDT_LIVE_ENABLED=false
USDT_RATE_SOURCE=peg
# Optional RPC overrides (comma-separated), e.g. a paid provider endpoint:
USDT_RPC_XLAYER=
USDT_RPC_POLYGON=

# Storage: local (dev) or s3 (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_PUBLIC=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

AI_ENDPOINT_ALLOWLIST=api.openai.com,generativelanguage.googleapis.com,api.anthropic.com
LOG_LEVEL=INFO
